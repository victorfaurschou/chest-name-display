{
	"schemaVersion": 1,
	"id": "storage-container-labels",
	"version": "${version}",
	"name": "Storage Container Labels",
	"description": "Displays labels above/around named storage containers like chests, barrels, Shulker boxes and more.",
	"authors": [
		"medicalwhiskey"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/storage-container-labels",
		"sources": "https://github.com/victorfaurschou/storage-container-labels",
		"issues": "https://github.com/victorfaurschou/storage-container-labels/issues"
	},
	"license": "MIT",
	"icon": "assets/storage-container-labels/icon.png",
	"environment": "*",
	"mixins": [
		"storage-container-labels.mixins.json"
	],
	"entrypoints": {
		"client": [
			"com.victorfaurschou.storagecontainerlabels.client.StorageContainerLabelsClient"
		],
		"modmenu": [
			"com.victorfaurschou.storagecontainerlabels.client.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": ">=26.1.2 <26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"cloth-config": "*"
	}
}
